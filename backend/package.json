{
  "name": "eeuez-assist-backend",
  "version": "2.0.0",
  "description": "Backend Node.js pour EEUEZ-Assist avec OAuth, MongoDB et Gemini API",
  "main": "src/app.ts",
  "scripts": {
    "start": "ts-node src/app.ts",
    "dev": "nodemon --exec ts-node src/app.ts",
    "migrate": "ts-node src/scripts/migrate.ts",
    "seed": "ts-node src/scripts/seed.ts",
    "seed:admin": "ts-node src/scripts/seed-admin.ts"
  },
  "keywords": [
    "chatbot",
    "gemini",
    "nodejs",
    "oauth",
    "mongodb",
    "eeuez"
  ],
  "author": "Équipe EEUEZ - Hackathon G3",
  "license": "ISC",
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^17.3.1",
    "express": "^5.2.1",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.3",
    "mysql2": "^3.17.4"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10"
  }
}
